[Unit]
Description=Mormi Backend (Spring Boot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mormi
Group=mormi
WorkingDirectory=/opt/mormi-backend

EnvironmentFile=/etc/mormi-backend/mormi.env

ExecStart=/usr/bin/java -jar /opt/mormi-backend/app.jar

Restart=on-failure
RestartSec=5
SuccessExitStatus=143

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mormi-backend

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
